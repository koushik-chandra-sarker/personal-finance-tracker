generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String                 @id @default(cuid())
  name          String
  email         String                 @unique
  password      String
  role          UserRole               @default(USER)
  status        UserStatus             @default(ACTIVE)
  currency      String                 @default("USD")
  lastLoginAt   DateTime?
  emailVerifiedAt DateTime?
  lockedUntil   DateTime?
  sessionVersion Int                   @default(1)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  accounts      Account[]
  budgets       Budget[]
  categories    Category[]
  financialNotes FinancialNote[]
  goals         Goal[]
  notifications Notification[]
  notificationPreference NotificationPreference?
  recurringTxns RecurringTransaction[]
  joinedShares  SharedAccess[]         @relation("JoinedShares")
  ownedShares   SharedAccess[]         @relation("OwnedShares")
  grantedSubscriptions UserSubscription[] @relation("GrantedSubscriptions")
  sentInvites    UserInvite[]           @relation("SentUserInvites")
  subscription  UserSubscription?
  transactions  Transaction[]

  @@index([status])
  @@index([lastLoginAt])
}

model UserInvite {
  id          String               @id @default(cuid())
  email       String
  role        UserRole             @default(USER)
  packageId   String?
  tokenHash   String               @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  invitedBy   User?                @relation("SentUserInvites", fields: [invitedById], references: [id], onDelete: SetNull)
  package     SubscriptionPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([expiresAt])
  @@index([acceptedAt])
}

model UserSubscription {
  id                     String                @id @default(cuid())
  userId                 String                @unique
  packageId              String?
  plan                   SubscriptionPlan      @default(PRO)
  interval               SubscriptionInterval?
  source                 SubscriptionSource  @default(SELF_SERVICE)
  status                 SubscriptionStatus    @default(ACTIVE)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean               @default(false)
  grantedById            String?
  providerCustomerId     String?
  providerSubscriptionId String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  grantedBy              User?                 @relation("GrantedSubscriptions", fields: [grantedById], references: [id], onDelete: SetNull)
  package                SubscriptionPackage?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([packageId])
  @@index([plan, status])
}

model SubscriptionPackage {
  id             String                @id @default(cuid())
  slug           String                @unique
  name           String
  description    String
  currency       String                @default("BDT")
  price          Decimal               @db.Decimal(12, 2)
  interval       SubscriptionInterval
  trialDays      Int                   @default(0)
  discountLabel  String?
  featureBullets String[]              @default([])
  isActive       Boolean               @default(true)
  isFeatured     Boolean               @default(false)
  sortOrder      Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  invites        UserInvite[]
  subscriptions  UserSubscription[]

  @@index([isActive, sortOrder])
  @@index([interval])
}

model SharedAccess {
  id             String          @id @default(cuid())
  ownerId        String
  collaboratorId String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  permissions    FeatureAccess[]
  collaborator   User            @relation("JoinedShares", fields: [collaboratorId], references: [id], onDelete: Cascade)
  owner          User            @relation("OwnedShares", fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, collaboratorId])
  @@index([ownerId])
  @@index([collaboratorId])
}

model FeatureAccess {
  id             String       @id @default(cuid())
  sharedAccessId String
  feature        Feature
  accessLevel    AccessLevel  @default(NONE)
  sharedAccess   SharedAccess @relation(fields: [sharedAccessId], references: [id], onDelete: Cascade)

  @@unique([sharedAccessId, feature])
}

model Account {
  id           String        @id @default(cuid())
  userId       String
  name         String
  type         AccountType
  balance      Decimal       @default(0) @db.Decimal(12, 2)
  color        String        @default("#6366f1")
  icon         String        @default("wallet")
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  createdById  String?
  updatedById  String?
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

model Category {
  id           String        @id @default(cuid())
  userId       String
  name         String
  type         CategoryType
  icon         String        @default("tag")
  color        String        @default("#8b5cf6")
  isDefault    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  createdById  String?
  updatedById  String?
  budgets      Budget[]
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name, type])
  @@index([userId])
}

model Transaction {
  id          String       @id @default(cuid())
  userId      String
  accountId   String
  categoryId  String
  type        CategoryType
  amount      Decimal      @db.Decimal(12, 2)
  description String
  date        DateTime
  tags        String[]     @default([])
  notes       String?
  isRecurring Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdById String?
  updatedById String?
  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, categoryId])
  @@index([userId, accountId])
}

model Budget {
  id              String   @id @default(cuid())
  userId          String
  categoryId      String
  amount          Decimal  @db.Decimal(12, 2)
  rolloverEnabled Boolean  @default(false)
  month           Int
  year            Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdById     String?
  updatedById     String?
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month, year])
  @@index([userId, month, year])
}

model RecurringTransaction {
  id          String       @id @default(cuid())
  userId      String
  accountId   String
  categoryId  String
  type        CategoryType
  amount      Decimal      @db.Decimal(12, 2)
  description String
  frequency   Frequency
  nextRunDate DateTime
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdById String?
  updatedById String?
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([nextRunDate])
}

model Goal {
  id            String         @id @default(cuid())
  userId        String
  name          String
  targetAmount  Decimal        @db.Decimal(12, 2)
  currentAmount Decimal        @default(0) @db.Decimal(12, 2)
  deadline      DateTime
  color         String         @default("#10b981")
  icon          String         @default("target")
  isCompleted   Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  createdById   String?
  updatedById   String?
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress      GoalProgress[]

  @@index([userId])
}

model GoalProgress {
  id          String              @id @default(cuid())
  goalId      String
  amount      Decimal             @db.Decimal(12, 2)
  type        GoalTransactionType
  description String?
  createdAt   DateTime            @default(now())
  goal        Goal                @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

model Notification {
  id         String                @id @default(cuid())
  userId     String
  title      String
  message    String
  type       NotificationType
  severity   NotificationSeverity @default(INFO)
  sourceType NotificationSource?
  sourceId   String?
  dedupeKey  String?
  actionUrl  String?
  isRead     Boolean              @default(false)
  createdAt  DateTime             @default(now())
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, isRead])
  @@index([userId, type, createdAt])
}

model NotificationPreference {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  billRemindersEnabled     Boolean  @default(true)
  billReminderDaysBefore   Int      @default(3)
  budgetAlertsEnabled      Boolean  @default(true)
  budgetWarningThreshold   Int      @default(80)
  budgetCriticalThreshold  Int      @default(100)
  goalDeadlineEnabled      Boolean  @default(true)
  goalReminderDaysBefore   Int      @default(14)
  unusualExpenseEnabled    Boolean  @default(true)
  unusualExpenseMultiplier Decimal  @default(2.00) @db.Decimal(6, 2)
  unusualExpenseMinAmount  Decimal  @default(50.00) @db.Decimal(12, 2)
  lowBalanceEnabled        Boolean  @default(true)
  lowBalanceThreshold      Decimal  @default(100.00) @db.Decimal(12, 2)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FinancialNote {
  id                 String                  @id @default(cuid())
  userId             String
  mode               FinancialNoteMode       @default(SIMPLE)
  title              String
  description        String
  tags               String[]                @default([])
  counterpartyName   String?
  valueType          FinancialNoteValueType?
  amount             Decimal?                @db.Decimal(12, 2)
  assetName          String?
  assetDetails       String?
  providedDate       DateTime?
  expectedReturnDate DateTime?
  returnedDate       DateTime?
  status             FinancialNoteStatus?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  createdById        String?
  updatedById        String?
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, expectedReturnDate])
  @@index([userId, status])
}

enum Feature {
  TRANSACTIONS
  ACCOUNTS
  BUDGETS
  GOALS
  REPORTS
  SETTINGS
  NOTES
}

enum AccessLevel {
  NONE
  VIEW
  EDIT
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
  DELETED
}

enum SubscriptionPlan {
  PRO
}

enum SubscriptionSource {
  SELF_SERVICE
  ADMIN_GRANT
}

enum SubscriptionInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
}

enum AccountType {
  CASH
  BANK
  MOBILE_WALLET
  CREDIT_CARD
  INVESTMENT
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum FinancialNoteMode {
  SIMPLE
  EXTENDED
}

enum FinancialNoteValueType {
  MONEY
  ASSET
  MONEY_AND_ASSET
  OTHER
}

enum FinancialNoteStatus {
  OPEN
  PARTIAL
  RETURNED
  CANCELLED
}

enum Frequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum GoalTransactionType {
  CONTRIBUTION
  DEDUCTION
}

enum NotificationType {
  BILL_REMINDER
  BUDGET_ALERT
  GOAL_DEADLINE
  GOAL_REACHED
  UNUSUAL_EXPENSE
  LOW_BALANCE
  RECURRING_CREATED
  INSIGHT
  SYSTEM
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
  SUCCESS
}

enum NotificationSource {
  RECURRING_TRANSACTION
  BUDGET
  GOAL
  TRANSACTION
  ACCOUNT
  SYSTEM
}
