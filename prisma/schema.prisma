generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String                 @id @default(cuid())
  name          String
  email         String                 @unique
  password      String
  role          UserRole               @default(USER)
  status        UserStatus             @default(ACTIVE)
  currency      String                 @default("USD")
  lastLoginAt   DateTime?
  emailVerifiedAt DateTime?
  mustChangePassword Boolean              @default(false)
  lockedUntil   DateTime?
  sessionVersion Int                   @default(1)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  accounts      Account[]
  adminMessageStates AdminMessageState[]
  adminMessageRecipients AdminMessageRecipient[]
  adminSupportAccessAudits SupportAccessAudit[] @relation("AdminSupportAccessAudits")
  adminSupportAccessSessions SupportAccessSession[] @relation("AdminSupportAccessSessions")
  budgets       Budget[]
  categories    Category[]
  financialNotes FinancialNote[]
  goals         Goal[]
  investments   Investment[]
  investmentTypeConfigs InvestmentTypeConfig[]
  notifications Notification[]
  notificationPreference NotificationPreference?
  pageViews     PageView[]
  recurringTxns RecurringTransaction[]
  userActivities UserActivity[]
  joinedShares  SharedAccess[]         @relation("JoinedShares")
  ownedShares   SharedAccess[]         @relation("OwnedShares")
  grantedSubscriptions UserSubscription[] @relation("GrantedSubscriptions")
  manualPaymentRequests ManualPaymentRequest[] @relation("ManualPaymentRequests")
  reviewedManualPayments ManualPaymentRequest[] @relation("ReviewedManualPayments")
  sentInvites    UserInvite[]           @relation("SentUserInvites")
  subscription  UserSubscription?
  supportAccessAudits SupportAccessAudit[] @relation("UserSupportAccessAudits")
  supportAccessSessions SupportAccessSession[] @relation("UserSupportAccessSessions")
  supportMessages SupportMessage[] @relation("UserSupportMessages")
  supportTickets SupportTicket[] @relation("UserSupportTickets")
  transactions  Transaction[]
  createdAdminMessages AdminMessage[] @relation("CreatedAdminMessages")

  @@index([status])
  @@index([lastLoginAt])
}

model UserInvite {
  id          String               @id @default(cuid())
  email       String
  role        UserRole             @default(USER)
  packageId   String?
  tokenHash   String               @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  invitedBy   User?                @relation("SentUserInvites", fields: [invitedById], references: [id], onDelete: SetNull)
  package     SubscriptionPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([expiresAt])
  @@index([acceptedAt])
}

model UserSubscription {
  id                     String                @id @default(cuid())
  userId                 String                @unique
  packageId              String?
  plan                   SubscriptionPlan      @default(PRO)
  interval               SubscriptionInterval?
  source                 SubscriptionSource  @default(SELF_SERVICE)
  status                 SubscriptionStatus    @default(ACTIVE)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean               @default(false)
  grantedById            String?
  providerCustomerId     String?
  providerSubscriptionId String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  grantedBy              User?                 @relation("GrantedSubscriptions", fields: [grantedById], references: [id], onDelete: SetNull)
  package                SubscriptionPackage?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([packageId])
  @@index([plan, status])
}

model SubscriptionPackage {
  id             String                @id @default(cuid())
  slug           String                @unique
  name           String
  description    String
  currency       String                @default("BDT")
  price          Decimal               @db.Decimal(12, 2)
  interval       SubscriptionInterval
  trialDays      Int                   @default(0)
  discountLabel  String?
  featureBullets String[]              @default([])
  isActive       Boolean               @default(true)
  isFeatured     Boolean               @default(false)
  sortOrder      Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  invites        UserInvite[]
  manualPaymentRequests ManualPaymentRequest[]
  subscriptions  UserSubscription[]

  @@index([isActive, sortOrder])
  @@index([interval])
}

model ManualPaymentMethod {
  id            String                 @id @default(cuid())
  provider      ManualPaymentProvider
  label         String
  accountNumber String
  accountName   String
  instructions  String?
  isActive      Boolean                @default(true)
  sortOrder     Int                    @default(0)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  requests      ManualPaymentRequest[]

  @@index([provider, isActive])
  @@index([isActive, sortOrder])
}

model ManualPaymentRequest {
  id            String                 @id @default(cuid())
  userId        String
  packageId     String
  methodId      String?
  provider      ManualPaymentProvider
  status        ManualPaymentStatus    @default(PENDING)
  amount        Decimal                @db.Decimal(12, 2)
  currency      String                 @default("BDT")
  reference     String
  senderAccount String
  transactionId String
  paidAt        DateTime?
  screenshotUrl String?
  note          String?
  adminNote     String?
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  method         ManualPaymentMethod?  @relation(fields: [methodId], references: [id], onDelete: SetNull)
  package        SubscriptionPackage   @relation(fields: [packageId], references: [id], onDelete: Restrict)
  reviewedBy     User?                 @relation("ReviewedManualPayments", fields: [reviewedById], references: [id], onDelete: SetNull)
  user           User                  @relation("ManualPaymentRequests", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, transactionId])
  @@index([userId, status, createdAt])
  @@index([status, createdAt])
  @@index([packageId])
  @@index([methodId])
}

model SharedAccess {
  id             String          @id @default(cuid())
  ownerId        String
  collaboratorId String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  permissions    FeatureAccess[]
  collaborator   User            @relation("JoinedShares", fields: [collaboratorId], references: [id], onDelete: Cascade)
  owner          User            @relation("OwnedShares", fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, collaboratorId])
  @@index([ownerId])
  @@index([collaboratorId])
}

model FeatureAccess {
  id             String       @id @default(cuid())
  sharedAccessId String
  feature        Feature
  accessLevel    AccessLevel  @default(NONE)
  sharedAccess   SharedAccess @relation(fields: [sharedAccessId], references: [id], onDelete: Cascade)

  @@unique([sharedAccessId, feature])
}

model Account {
  id           String        @id @default(cuid())
  userId       String
  name         String
  type         AccountType
  balance      Decimal       @default(0) @db.Decimal(12, 2)
  color        String        @default("#6366f1")
  icon         String        @default("wallet")
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  createdById  String?
  updatedById  String?
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  investments  Investment[]
  investmentCashflows InvestmentCashflow[]

  @@index([userId])
}

model Category {
  id           String        @id @default(cuid())
  userId       String
  name         String
  type         CategoryType
  icon         String        @default("tag")
  color        String        @default("#8b5cf6")
  isDefault    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  createdById  String?
  updatedById  String?
  budgets      Budget[]
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name, type])
  @@index([userId])
}

model Transaction {
  id          String       @id @default(cuid())
  userId      String
  accountId   String
  categoryId  String
  type        CategoryType
  amount      Decimal      @db.Decimal(12, 2)
  description String
  date        DateTime
  tags        String[]     @default([])
  notes       String?
  isRecurring Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdById String?
  updatedById String?
  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  investmentCashflows InvestmentCashflow[]

  @@index([userId, date])
  @@index([userId, categoryId])
  @@index([userId, accountId])
}

model Budget {
  id              String   @id @default(cuid())
  userId          String
  categoryId      String
  amount          Decimal  @db.Decimal(12, 2)
  rolloverEnabled Boolean  @default(false)
  month           Int
  year            Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdById     String?
  updatedById     String?
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month, year])
  @@index([userId, month, year])
}

model RecurringTransaction {
  id          String       @id @default(cuid())
  userId      String
  accountId   String
  categoryId  String
  type        CategoryType
  amount      Decimal      @db.Decimal(12, 2)
  description String
  frequency   Frequency
  nextRunDate DateTime
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdById String?
  updatedById String?
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([nextRunDate])
}

model Goal {
  id            String         @id @default(cuid())
  userId        String
  name          String
  targetAmount  Decimal        @db.Decimal(12, 2)
  currentAmount Decimal        @default(0) @db.Decimal(12, 2)
  deadline      DateTime
  color         String         @default("#10b981")
  icon          String         @default("target")
  isCompleted   Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  createdById   String?
  updatedById   String?
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress      GoalProgress[]

  @@index([userId])
}

model GoalProgress {
  id          String              @id @default(cuid())
  goalId      String
  amount      Decimal             @db.Decimal(12, 2)
  type        GoalTransactionType
  description String?
  createdAt   DateTime            @default(now())
  goal        Goal                @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

model Notification {
  id         String                @id @default(cuid())
  userId     String
  title      String
  message    String
  type       NotificationType
  severity   NotificationSeverity @default(INFO)
  sourceType NotificationSource?
  sourceId   String?
  dedupeKey  String?
  actionUrl  String?
  isRead     Boolean              @default(false)
  createdAt  DateTime             @default(now())
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, isRead])
  @@index([userId, type, createdAt])
}

model NotificationPreference {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  billRemindersEnabled     Boolean  @default(true)
  billReminderDaysBefore   Int      @default(3)
  budgetAlertsEnabled      Boolean  @default(true)
  budgetWarningThreshold   Int      @default(80)
  budgetCriticalThreshold  Int      @default(100)
  goalDeadlineEnabled      Boolean  @default(true)
  goalReminderDaysBefore   Int      @default(14)
  unusualExpenseEnabled    Boolean  @default(true)
  unusualExpenseMultiplier Decimal  @default(2.00) @db.Decimal(6, 2)
  unusualExpenseMinAmount  Decimal  @default(50.00) @db.Decimal(12, 2)
  lowBalanceEnabled        Boolean  @default(true)
  lowBalanceThreshold      Decimal  @default(100.00) @db.Decimal(12, 2)
  investmentMaturityEnabled Boolean  @default(true)
  investmentReminderDaysBefore Int      @default(7)
  dpsReminderEnabled       Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminMessage {
  id          String                    @id @default(cuid())
  title       String
  message     String
  severity    NotificationSeverity      @default(INFO)
  displayMode AdminMessageDisplayMode   @default(MODAL)
  frequency   AdminMessageFrequency     @default(ONCE)
  audience    AdminMessageAudience      @default(ALL)
  showToUnsubscribed Boolean            @default(false)
  actionLabel String?
  actionUrl   String?
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean                   @default(true)
  createdById String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  createdBy   User?                     @relation("CreatedAdminMessages", fields: [createdById], references: [id], onDelete: SetNull)
  recipients  AdminMessageRecipient[]
  states      AdminMessageState[]

  @@index([isActive, startsAt, endsAt])
  @@index([audience])
  @@index([createdAt])
}

model AdminMessageRecipient {
  id        String       @id @default(cuid())
  messageId String
  userId    String
  message   AdminMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

model AdminMessageState {
  id          String       @id @default(cuid())
  messageId   String
  userId      String
  seenCount   Int          @default(0)
  lastSeenAt  DateTime?
  dismissedAt DateTime?
  message     AdminMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, dismissedAt])
}

model SupportTicket {
  id          String                @id @default(cuid())
  userId      String
  subject     String
  description String                @db.Text
  phoneNumber String?
  status      SupportTicketStatus   @default(OPEN)
  priority    SupportTicketPriority @default(NORMAL)
  category    SupportTicketCategory @default(GENERAL)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  resolvedAt  DateTime?
  user        User                  @relation("UserSupportTickets", fields: [userId], references: [id], onDelete: Cascade)
  messages    SupportMessage[]
  accessSessions SupportAccessSession[]
  auditLogs   SupportAccessAudit[]

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([updatedAt])
}

model SupportMessage {
  id          String        @id @default(cuid())
  ticketId    String
  senderId    String
  message     String        @db.Text
  isFromAdmin Boolean       @default(false)
  createdAt   DateTime      @default(now())
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender      User          @relation("UserSupportMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([senderId])
}

model SupportAccessSession {
  id             String    @id @default(cuid())
  userId         String
  adminId        String?
  ticketId       String?
  pinHash        String
  pinLookupHash  String
  pinExpiresAt   DateTime
  verifiedAt     DateTime?
  revokedAt      DateTime?
  failedAttempts Int       @default(0)
  lastFailedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation("UserSupportAccessSessions", fields: [userId], references: [id], onDelete: Cascade)
  admin          User?     @relation("AdminSupportAccessSessions", fields: [adminId], references: [id], onDelete: SetNull)
  ticket         SupportTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([adminId])
  @@index([ticketId])
  @@index([pinLookupHash])
  @@index([pinExpiresAt])
}

model SupportAccessAudit {
  id        String                   @id @default(cuid())
  userId    String
  adminId   String?
  ticketId  String?
  action    SupportAccessAuditAction
  metadata  Json?
  createdAt DateTime                 @default(now())
  user      User                     @relation("UserSupportAccessAudits", fields: [userId], references: [id], onDelete: Cascade)
  admin     User?                    @relation("AdminSupportAccessAudits", fields: [adminId], references: [id], onDelete: SetNull)
  ticket    SupportTicket?           @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([adminId, createdAt])
  @@index([ticketId])
}

model FinancialNote {
  id                 String                  @id @default(cuid())
  userId             String
  mode               FinancialNoteMode       @default(SIMPLE)
  title              String
  description        String
  tags               String[]                @default([])
  counterpartyName   String?
  valueType          FinancialNoteValueType?
  amount             Decimal?                @db.Decimal(12, 2)
  assetName          String?
  assetDetails       String?
  providedDate       DateTime?
  expectedReturnDate DateTime?
  returnedDate       DateTime?
  status             FinancialNoteStatus?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  createdById        String?
  updatedById        String?
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, expectedReturnDate])
  @@index([userId, status])
}

model PageView {
  id         String   @id @default(cuid())
  userId     String?
  visitorId  String
  sessionId  String
  path       String
  referrer   String?
  userAgent  String?
  deviceType String?
  browser    String?
  ipHash     String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([visitorId, createdAt])
  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
}

model UserActivity {
  id          String   @id @default(cuid())
  userId      String
  sessionId   String
  currentPath String
  userAgent   String?
  deviceType  String?
  browser     String?
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
  @@index([lastSeenAt])
  @@index([currentPath, lastSeenAt])
  @@index([userId, lastSeenAt])
}

enum Feature {
  TRANSACTIONS
  ACCOUNTS
  BUDGETS
  GOALS
  INVESTMENTS
  REPORTS
  SETTINGS
  NOTES
}

enum AccessLevel {
  NONE
  VIEW
  EDIT
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
  DELETED
}

enum SubscriptionPlan {
  FREE
  PRO
}

enum SubscriptionSource {
  SELF_SERVICE
  ADMIN_GRANT
}

enum SubscriptionInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
}

enum ManualPaymentProvider {
  BKASH
  NAGAD
}

enum ManualPaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AccountType {
  CASH
  BANK
  MOBILE_WALLET
  CREDIT_CARD
  INVESTMENT
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum FinancialNoteMode {
  SIMPLE
  EXTENDED
}

enum FinancialNoteValueType {
  MONEY
  ASSET
  MONEY_AND_ASSET
  OTHER
}

enum FinancialNoteStatus {
  OPEN
  PARTIAL
  RETURNED
  CANCELLED
}

enum Frequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum GoalTransactionType {
  CONTRIBUTION
  DEDUCTION
}

enum NotificationType {
  BILL_REMINDER
  BUDGET_ALERT
  GOAL_DEADLINE
  GOAL_REACHED
  INVESTMENT_MATURITY
  INVESTMENT_RETURN_DUE
  UNUSUAL_EXPENSE
  LOW_BALANCE
  RECURRING_CREATED
  INSIGHT
  SYSTEM
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
  SUCCESS
}

enum NotificationSource {
  RECURRING_TRANSACTION
  BUDGET
  GOAL
  INVESTMENT
  TRANSACTION
  ACCOUNT
  SYSTEM
}

enum AdminMessageAudience {
  ALL
  SELECTED
}

enum AdminMessageDisplayMode {
  MODAL
  BANNER
}

enum AdminMessageFrequency {
  EVERY_REFRESH
  ONCE
  UNTIL_DISMISSED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportTicketCategory {
  GENERAL
  BILLING
  BUG_REPORT
  FEATURE_REQUEST
  ACCOUNT_ISSUE
}

enum SupportAccessAuditAction {
  PIN_GENERATED
  PIN_REVOKED
  PIN_VERIFIED
  PIN_FAILED
  SUPPORT_VIEW_STARTED
  SUPPORT_VIEW_ENDED
  SUPPORT_VIEW_EXPIRED
}

enum InvestmentStatus {
  ACTIVE
  MATURED
  SOLD
  CANCELLED
}

enum ReturnFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  AT_MATURITY
  ON_SALE
}

enum InvestmentCashflowType {
  BUY
  ADD_FUNDS
  INSTALLMENT
  RETURN
  TAX
  FEE
  SALE
  MATURITY_PAYOUT
  REVERSAL
}

model InvestmentTypeConfig {
  id              String       @id @default(cuid())
  userId          String?
  slug            String
  name            String
  description     String?
  icon            String       @default("trending-up")
  color           String       @default("#6366f1")
  isSystem        Boolean      @default(false)
  isActive        Boolean      @default(true)
  sortOrder       Int          @default(0)

  hasInterestRate       Boolean @default(false)
  hasReturnFrequency    Boolean @default(false)
  hasMaturityDate       Boolean @default(true)
  hasMonthlyInstallment Boolean @default(false)
  hasQuantity           Boolean @default(false)
  hasInstitution        Boolean @default(true)
  hasAccountNumber      Boolean @default(true)

  returnTypes     String[]     @default([])

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user            User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  investments     Investment[]

  @@unique([userId, slug])
  @@index([userId, isActive])
}

model Investment {
  id                 String             @id @default(cuid())
  userId             String
  typeConfigId       String
  name               String
  status             InvestmentStatus   @default(ACTIVE)
  institutionName    String?
  accountNumber      String?

  investedAmount     Decimal            @db.Decimal(14, 2)
  currentValue       Decimal            @db.Decimal(14, 2)
  interestRate       Decimal?           @db.Decimal(6, 3)
  returnFrequency    ReturnFrequency?

  purchaseDate       DateTime
  maturityDate       DateTime?
  soldDate           DateTime?

  linkedAccountId    String?

  monthlyInstallment Decimal?           @db.Decimal(14, 2)
  installmentDueDay  Int?
  missedInstallmentCount Int            @default(0)
  lastMissedInstallmentOn DateTime?
  lastInstallmentPaidOn DateTime?

  quantity           Decimal?           @db.Decimal(14, 4)
  avgBuyPrice        Decimal?           @db.Decimal(14, 4)

  notes              String?
  color              String             @default("#6366f1")
  icon               String             @default("trending-up")
  sanchayapatraConfigId String?

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  createdById        String?
  updatedById        String?

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  typeConfig         InvestmentTypeConfig @relation(fields: [typeConfigId], references: [id])
  linkedAccount      Account?           @relation(fields: [linkedAccountId], references: [id], onDelete: SetNull)
  sanchayapatraConfig SanchayapatraConfig? @relation(fields: [sanchayapatraConfigId], references: [id], onDelete: SetNull)
  returns            InvestmentReturn[]
  valuations         InvestmentValuation[]
  cashflows          InvestmentCashflow[]

  @@index([userId, typeConfigId])
  @@index([userId, status])
  @@index([userId, maturityDate])
  @@index([sanchayapatraConfigId])
}

model InvestmentReturn {
  id            String     @id @default(cuid())
  investmentId  String
  amount        Decimal    @db.Decimal(14, 2)
  type          String
  description   String?
  date          DateTime
  createdAt     DateTime   @default(now())

  investment    Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@index([investmentId, date])
}

model InvestmentValuation {
  id            String     @id @default(cuid())
  investmentId  String
  value         Decimal    @db.Decimal(14, 2)
  date          DateTime
  createdAt     DateTime   @default(now())

  investment    Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@index([investmentId, date])
}

model InvestmentCashflow {
  id              String                 @id @default(cuid())
  investmentId    String
  transactionId   String?
  accountId       String?
  type            InvestmentCashflowType
  amount          Decimal                @db.Decimal(14, 2)
  principalAmount Decimal                @default(0) @db.Decimal(14, 2)
  returnAmount    Decimal                @default(0) @db.Decimal(14, 2)
  taxAmount       Decimal                @default(0) @db.Decimal(14, 2)
  date            DateTime
  installmentDueDate DateTime?
  description     String?
  createdAt       DateTime               @default(now())
  createdById     String?

  investment  Investment   @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  account     Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([investmentId, date])
  @@index([transactionId])
  @@index([accountId])
  @@index([type, date])
  @@index([investmentId, installmentDueDate])
}

model SanchayapatraConfig {
  id               String   @id @default(cuid())
  type             String   @unique // poribar, pensioner, 3monthly, 5year
  name             String
  description      String?
  rate             Decimal  @db.Decimal(5, 2)
  taxThreshold     Decimal  @db.Decimal(12, 2) @default(500000)
  taxRateBelow     Decimal  @db.Decimal(5, 2) @default(5)
  taxRateAbove     Decimal  @db.Decimal(5, 2) @default(10)
  payoutFrequency  String   // MONTHLY, QUARTERLY, AT_MATURITY
  updatedAt        DateTime @updatedAt
  investments      Investment[]
}

model Tutorial {
  id          String   @id @default(cuid())
  title       String
  description String?
  youtubeUrl  String
  thumbnailUrl String?
  category    String?  @default("General")
  isActive    Boolean  @default(true)
  isPremium   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}
